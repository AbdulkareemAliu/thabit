{
  "scripts": {
    "dev": "vite",
    "free-preview-port": "lsof -t -iTCP:4173 -sTCP:LISTEN | xargs kill 2>/dev/null || true",
    "dev:phone": "npm run build:preview && npm run free-preview-port && THABIT_PHONE=1 vite preview --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && VITE_DISABLE_SW=1 vite build",
    "deploy:netlify": "npm run build && npx --yes netlify-cli deploy --prod --dir=dist",
    "dev:phone:tunnel": "node scripts/dev-phone-tunnel.mjs",
    "preview": "npm run build:preview && vite preview",
    "preview:phone": "npm run build:preview && npm run free-preview-port && THABIT_HTTPS=1 THABIT_PHONE=1 vite preview --host 0.0.0.0",
    "preview:phone:http": "npm run dev:phone"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright": "^1.60.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite-plugin-pwa": "^1.3.0"
  }
}
