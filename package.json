{
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && VITE_DISABLE_SW=1 vite build",
    "preview": "npm run build:preview && vite preview",
    "preview:phone": "npm run build:preview && THABIT_HTTPS=1 vite preview --host 0.0.0.0",
    "preview:phone:http": "npm run build:preview && vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright": "^1.60.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite-plugin-pwa": "^1.3.0"
  }
}
